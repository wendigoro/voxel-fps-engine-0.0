+        float dashSpeed = DASH_DISTANCE / DASH_DURATION;
+        g_camPos = g_camPos + m.dashDir * dashSpeed * dt;
+        
+        if (m.dashTime <= 0.0f) {
+            m.dashing = false;
+            m.dashDir = {0,0,0};
+        }
+    }
