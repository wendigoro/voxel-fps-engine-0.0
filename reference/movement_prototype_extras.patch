+        m.slideTime += dt;
+        m.slideSpeed *= std::pow(SLIDE_FRICTION, dt);
+        
+        if (m.slideSpeed < SLIDE_MIN_SPEED || m.slideTime > SLIDE_MAX_TIME || onGround == false) {
