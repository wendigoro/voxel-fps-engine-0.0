+        if (inputForward) moveDir = moveDir + flatFwd;
+        if (inputBack) moveDir = moveDir - flatFwd;
+        if (inputLeft) moveDir = moveDir - flatRight;
+        if (inputRight) moveDir = moveDir + flatRight;
