+    if (wallSide != 0 && !m.dashing && !m.sliding) {
+        if (!m.wallRunning) {
+            m.wallRunning = true;
+            m.wallRunSide = wallSide;
+            m.wallRunTime = 0.0f;
+        } else if (m.wallRunSide == wallSide) {
+            m.wallRunTime += dt;
+            if (m.wallRunTime > WALLRUN_MAX_TIME) {
+                m.wallRunning = false;
+            }
